{
  "name": "business-trip-proof",
  "productName": "출장비 증빙 정리",
  "version": "1.1.16",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node server.mjs",
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis",
    "update:keys": "node scripts/generate-update-keys.mjs",
    "update:publish": "node scripts/publish-update.mjs"
  },
  "dependencies": {
    "@phosphor-icons/web": "2.1.2",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "electron": "42.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kr.co.personal.businesstripproof",
    "productName": "출장비 증빙 정리",
    "asar": true,
    "files": [
      "desktop/**/*",
      "src/**/*",
      "assets/**/*",
      "server.mjs",
      "travel-proof.html",
      "package.json"
    ],
    "asarUnpack": [
      "src/travel-proof/*.ps1"
    ],
    "compression": "store",
    "extraResources": [
      {
        "from": "build/app-icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "build/update-public-key.pem",
        "to": "update-public-key.pem"
      },
      {
        "from": "build/expense-template.b64",
        "to": "expense-template.b64"
      }
    ],
    "win": {
      "icon": "build/app-icon.ico",
      "signExecutable": false,
      "target": [
        "nsis"
      ],
      "artifactName": "BusinessTripProof-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
